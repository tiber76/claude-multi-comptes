<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeMultiComptes.Linux.MainWindow"
        Title="Claude Multi Comptes" Width="920" Height="790" MinWidth="700" MinHeight="620"
        Background="#17191B" Foreground="#F4F4F4" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="68,*">
    <Border Grid.Row="0" Background="#1D1F21" BorderBrush="#2B2D30" BorderThickness="0,0,0,1" Padding="25,0">
      <DockPanel LastChildFill="True" VerticalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="11" Background="#C85F45" DockPanel.Dock="Left" Margin="0,0,13,0">
          <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Claude Multi Comptes" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="Tes espaces, chacun à sa place" Foreground="#A2A5A8" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Right" Background="#282A2C" CornerRadius="20" Padding="12,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ClaudeStatusDot" Width="8" Height="8" Fill="#48C774" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="ClaudeStatusText" Text="Recherche de Claude…" Foreground="#A2A5A8" FontSize="12" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="30,26,30,24">
        <Border Background="#202225" BorderBrush="#2D3033" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,25">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Tous tes comptes Claude." FontSize="25" FontWeight="SemiBold" />
              <TextBlock Text="Crée un espace par compte, connecte-toi une fois, puis lance les sessions dont tu as besoin." Foreground="#A2A5A8" TextWrapping="Wrap" MaxWidth="560" Margin="0,10,0,0" />
              <TextBlock Text="🔒  Sessions gardées séparément sur cet ordinateur" Foreground="#9AA7A0" FontSize="12" FontWeight="SemiBold" Margin="0,15,0,0" />
            </StackPanel>
            <Button x:Name="AddProfileButton" Grid.Column="1" Content="＋  Ajouter un compte" Background="#C85F45" Foreground="White" Padding="17,12" VerticalAlignment="Center" Click="AddProfile_Click" />
          </Grid>
        </Border>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="MES COMPTES" FontSize="11" FontWeight="Bold" Foreground="#A2A5A8" />
          <TextBlock x:Name="OpenCountText" DockPanel.Dock="Right" Text="0 ouverts" FontSize="12" Foreground="#A2A5A8" />
        </DockPanel>
        <StackPanel x:Name="ProfileList" />
        <Border Background="#1D1F21" BorderBrush="#2D3033" BorderThickness="1" CornerRadius="17" Padding="16" Margin="0,26,0,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <TextBlock Text="⟳  MISES À JOUR" FontSize="11" FontWeight="Bold" Foreground="#A2A5A8" />
              <TextBlock Text="Claude Desktop · Claude Code" DockPanel.Dock="Right" Foreground="#777B7F" FontSize="11" />
            </DockPanel>
            <Grid ColumnDefinitions="*,*" Margin="0,0,0,13">
              <Button Content="Mettre à jour Claude Desktop&#10;Mises à jour via apt" HorizontalContentAlignment="Left" Margin="0,0,6,0" Click="DesktopUpdate_Click" />
              <Button x:Name="CodeUpdateButton" Grid.Column="1" Content="Mettre à jour Claude Code&#10;Lancer la commande officielle" HorizontalContentAlignment="Left" Margin="6,0,0,0" Click="CodeUpdate_Click" />
            </Grid>
            <DockPanel Background="#26282A">
              <Button Content="↻" DockPanel.Dock="Right" Padding="10,4" Margin="7,0,0,0" Click="RefreshVersions_Click" ToolTip.Tip="Vérifier les versions" />
              <TextBlock x:Name="CodeVersionText" Text="Claude Code installée — · dernière publiée —" Foreground="#A2A5A8" VerticalAlignment="Center" Padding="12,10" TextWrapping="Wrap" />
            </DockPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="Au premier lancement, connecte-toi au compte choisi dans la fenêtre Claude. Ferme cette fenêtre pour arrêter la session. Les réglages et connexions propres à chaque profil restent séparés." Foreground="#A2A5A8" FontSize="12" TextWrapping="Wrap" Margin="2,20,2,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
