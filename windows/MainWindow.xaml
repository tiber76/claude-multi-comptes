<Window x:Class="ClaudeMultiComptes.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Multi Comptes" Width="900" Height="780" MinWidth="700" MinHeight="620"
        Background="{StaticResource Page}" Foreground="#F4F4F4" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1D1F21" BorderBrush="#2B2D30" BorderThickness="0,0,0,1" Padding="24,0">
      <DockPanel LastChildFill="True" VerticalAlignment="Center">
        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource Accent}" DockPanel.Dock="Left" Margin="0,0,13,0">
          <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Claude Multi Comptes" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="Tes espaces, chacun à sa place" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
        <Border DockPanel.Dock="Right" Background="#282A2C" CornerRadius="20" Padding="12,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ClaudeStatusDot" Width="8" Height="8" Fill="#48C774" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="ClaudeStatusText" Text="Recherche de Claude…" Foreground="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="30,26,30,24">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,25">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Tous tes comptes Claude." FontSize="25" FontWeight="SemiBold" />
              <TextBlock Text="Crée un espace par compte, connecte-toi une fois, puis lance les sessions dont tu as besoin." Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="550" Margin="0,10,0,0" />
              <TextBlock Text="🔒  Sessions gardées séparément sur ce PC" Foreground="#9AA7A0" FontSize="12" FontWeight="SemiBold" Margin="0,15,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="＋  Ajouter un compte" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" Padding="17,12" VerticalAlignment="Center" Click="AddProfile_Click" />
          </Grid>
        </Border>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="MES COMPTES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" />
          <TextBlock x:Name="OpenCountText" DockPanel.Dock="Right" Text="0 ouverts" FontSize="12" Foreground="{StaticResource Muted}" />
        </DockPanel>
        <StackPanel x:Name="ProfileList" />
        <Border Background="#1D1F21" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="17" Padding="16" Margin="0,26,0,0">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <TextBlock Text="⟳  MISES À JOUR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" />
              <TextBlock Text="Claude Desktop · Claude Code" DockPanel.Dock="Right" Foreground="#777B7F" FontSize="11" />
            </DockPanel>
            <UniformGrid Columns="2" Margin="0,0,0,13">
              <Button Content="Mettre à jour Claude Desktop&#10;Automatique dans l’app · téléchargement manuel" HorizontalContentAlignment="Left" Margin="0,0,6,0" Click="DesktopUpdate_Click" />
              <Button x:Name="CodeUpdateButton" Content="Mettre à jour Claude Code&#10;Lancer la commande officielle" HorizontalContentAlignment="Left" Margin="6,0,0,0" Click="CodeUpdate_Click" />
            </UniformGrid>
            <DockPanel Background="#26282A" LastChildFill="True" Margin="0,0,0,0">
              <Button Content="↻" DockPanel.Dock="Right" Padding="10,4" Margin="7,0,0,0" Click="RefreshVersions_Click" ToolTip="Vérifier les versions" />
              <TextBlock x:Name="CodeVersionText" Text="Claude Code installée — · dernière publiée —" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Padding="12,10" TextWrapping="Wrap" />
            </DockPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="Au premier lancement, connecte-toi au compte choisi dans la fenêtre Claude. Ferme une fenêtre Claude pour arrêter cette session. Chaque profil garde ses propres données." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,20,2,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
